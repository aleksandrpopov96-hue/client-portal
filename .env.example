# Copy this file to .env and edit the values, then run ./deploy.sh

# The dataset folder that filebrowser serves (e.g. /mnt/tank/clients)
# Must be the SAME files the filebrowser app shows.
PORTAL_FILES_PATH=/mnt/tank/clients

# Where the portal keeps its database + logos (a small persistent folder)
PORTAL_DATA_PATH=/mnt/tank/portal-data

# Set your own admin password for http://<nas>:8080/admin
PORTAL_ADMIN_PASSWORD=CHANGE_ME

# Port the portal listens on inside TrueNAS
PORTAL_PORT=8080
