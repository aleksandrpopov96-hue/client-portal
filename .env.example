# Copy this file to .env and edit the values, then run ./deploy.sh

# ---- Files the portal serves ----------------------------------------------
# What the portal's file browser shows. Set to the WHOLE TrueNAS filesystem
# to see every pool/dataset on the NAS:
PORTAL_FILES_PATH=/mnt
# ...or restrict it to a single dataset/share instead (then only that is browsable):
#PORTAL_FILES_PATH=/mnt/NormalusNAS/SUBKINAS

# Small persistent folder for the portal database, logo and secret key.
# Create it once as its own dataset (e.g. "client-portal-data"):
PORTAL_DATA_PATH=/mnt/tank/portal-data

# ---- Permissions ----------------------------------------------------------
# The container runs as a non-root user by default; PUID/PGID must equal the
# numeric owner (uid:gid) of the folder in PORTAL_DATA_PATH.
# Find it with:  ls -dn /mnt/tank/portal-data
# (TrueNAS "apps" datasets are typically owned by uid:gid 3000:3000.)
PUID=3000
PGID=3000
#
# To browse the WHOLE NAS with PORTAL_FILES_PATH=/mnt, the portal must be able
# to read the root-owned datasets. Either grant read ACLs to the PUID user on
# each dataset, OR run the container as root by uncommenting  user: "0:0"
# in docker-compose.yml (read AND write/delete anywhere - use folder scopes!).

# ---- Admin ----------------------------------------------------------------
# Password for the /admin panel (username is "admin"). Change this!
PORTAL_ADMIN_PASSWORD=CHANGE_ME

# Port the portal listens on inside TrueNAS (used only when not behind a tunnel)
PORTAL_PORT=8080

# ---- Cloudflare Tunnel (optional) ---------------------------------------
# Create a tunnel in https://one.dash.cloudflare.com -> Networks -> Tunnels
# and paste its token here. Then uncomment the `cloudflared` service in
# docker-compose.yml and route your hostname's service to http://localhost:8080.
CLOUDFLARED_TOKEN=